APP_URL=http://localhost:3000

# Projet Supabase DE DÉVELOPPEMENT uniquement (connexion Session/Transaction pooler)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[SUPABASE_PUBLISHABLE_OR_ANON_KEY]
# Server-only: used exclusively by the authorized project deliverable routes.
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_KEY]
SUPABASE_STORAGE_BUCKET=studio-deliverables
# Secret used to authorize the daily Vercel cron endpoint (generate a long random value).
CRON_SECRET=[LONG_RANDOM_SECRET]
# Demandes de réservation en attente : 48 h par défaut, valeur bornée à 24–168 h.
BOOKING_REQUEST_TTL_HOURS=48

# ImageKit — médias publics et galeries (à activer lorsque l'intégration est branchée)
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/[IMAGEKIT_ID]
# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=[IMAGEKIT_PUBLIC_KEY]
# IMAGEKIT_PRIVATE_KEY=[IMAGEKIT_PRIVATE_KEY]
# IMAGEKIT_UPLOAD_FOLDER=/studio-plus/dev

# Seed de comptes de test DEV uniquement (ne jamais activer sur Production)
# SEED_DEMO_USERS=true
# SEED_ENV=dev
# SEED_DEFAULT_PASSWORD=Change-me-12-characters
# SEED_EMAIL_SUFFIX=@studio-plus-dev.test

# E-mails transactionnels (serveur uniquement)
RESEND_API_KEY=re_[development_key]
EMAIL_FROM=Studio+ <notifications@studioplusci.com>
# Signature secret generated in Supabase Authentication > Hooks > Send Email.
SEND_EMAIL_HOOK_SECRET=v1,whsec_[HOOK_SECRET]
STUDIO_BOOKING_EMAIL=[STUDIO_TEAM_EMAIL]
