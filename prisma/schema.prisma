generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  MTN_MOMO
  BANK_TRANSFER
  OTHER
}

enum InvitationStatus {
  INVITED
  ACCEPTED
  DECLINED
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  phone     String?
  role      Role     @default(CLIENT)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings    Booking[]
  payments    BookingPayment[] @relation("RecordedPayments")
  assignments BookingStaff[]
  availabilityRules StaffAvailabilityRule[]
  availabilityExceptions StaffAvailabilityException[]
  receivedTeamInvitation TeamInvitation?  @relation("InvitedProfile")
  sentTeamInvitations   TeamInvitation[] @relation("InvitedByProfile")

  @@map("profiles")
}

model Service {
  id          String   @id
  name        String
  duration    Int
  price       Int?
  image       String
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@map("studio_services")
}

model Booking {
  id        String        @id @default(uuid()) @db.Uuid
  ownerId   String        @db.Uuid @map("owner_id")
  serviceId String        @map("service_id")
  title     String
  date      String        @db.VarChar(10)
  time      String        @db.VarChar(5)
  duration  Int
  amount    Int?
  status    BookingStatus @default(REQUESTED)
  name      String
  email     String
  phone     String
  notes     String        @default("")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  expiresAt DateTime?     @map("expires_at")

  owner        Profile             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  service      Service             @relation(fields: [serviceId], references: [id])
  slots        BookingSlot[]
  participants BookingParticipant[]
  invitations  GuestInvitation[]
  payments     BookingPayment[]
  assignments  BookingStaff[]
  scheduleChanges BookingScheduleChange[]
  project      StudioProject?
  invoice      StudioInvoice?

  @@index([ownerId, date, time])
  @@index([status, date])
  @@map("studio_bookings")
}

model TeamInvitation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid @map("user_id")
  invitedBy String   @db.Uuid @map("invited_by")
  email     String
  fullName  String   @map("full_name")
  role      Role
  status    String   @default("PENDING")
  tokenDigest String  @unique @map("token_digest")
  expiresAt DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    Profile @relation("InvitedProfile", fields: [userId], references: [id], onDelete: Cascade)
  inviter Profile @relation("InvitedByProfile", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("team_invitations")
}

model BookingSlot {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid @map("booking_id")
  date      String   @db.VarChar(10)
  time      String   @db.VarChar(5)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([date, time])
  @@index([bookingId])
  @@map("studio_slots")
}

model BookingParticipant {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid @map("booking_id")
  name      String
  email     String
  role      String  @default("Invité")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, email])
  @@index([email])
  @@map("studio_participants")
}

model GuestInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @db.Uuid @map("booking_id")
  name        String
  email       String?
  phone       String?
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(INVITED)
  note        String?
  bio         String?
  photoPath   String?          @map("photo_path")
  socialLinks Json?            @map("social_links")
  rundown     String?
  imageConsent Boolean         @default(false) @map("image_consent")
  imageConsentAt DateTime?     @map("image_consent_at")
  imageConsentRevokedAt DateTime? @map("image_consent_revoked_at")
  proposedDate String?         @map("proposed_date") @db.VarChar(10)
  proposedTime String?         @map("proposed_time") @db.VarChar(5)
  expiresAt   DateTime         @map("expires_at")
  respondedAt DateTime?        @map("responded_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@map("guest_invitations")
}

model BookingPayment {
  id         String        @id @default(uuid()) @db.Uuid
  bookingId  String        @db.Uuid @map("booking_id")
  amount     Int
  method     PaymentMethod
  reference  String?
  recordedBy String        @db.Uuid @map("recorded_by")
  paidAt     DateTime      @default(now()) @map("paid_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor      Profile       @relation("RecordedPayments", fields: [recordedBy], references: [id])

  @@index([bookingId, paidAt])
  @@map("booking_payments")
}

model BookingStaff {
  bookingId String  @db.Uuid @map("booking_id")
  staffId   String  @db.Uuid @map("staff_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff     Profile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([bookingId, staffId])
  @@map("booking_staff")
}

model StaffAvailabilityRule {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @db.Uuid @map("staff_id")
  weekday   Int
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  staff     Profile  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, weekday, startTime])
  @@map("staff_availability_rules")
}

model StaffAvailabilityException {
  id          String   @id @default(uuid()) @db.Uuid
  staffId     String   @db.Uuid @map("staff_id")
  date        String   @db.VarChar(10)
  isAvailable Boolean  @default(false) @map("is_available")
  startTime   String?  @map("start_time") @db.VarChar(5)
  endTime     String?  @map("end_time") @db.VarChar(5)
  note        String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  staff       Profile  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@map("staff_availability_exceptions")
}

model BookingScheduleChange {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String   @db.Uuid @map("booking_id")
  requestedBy  String   @db.Uuid @map("requested_by")
  oldDate      String   @map("old_date") @db.VarChar(10)
  oldTime      String   @map("old_time") @db.VarChar(5)
  newDate      String   @map("new_date") @db.VarChar(10)
  newTime      String   @map("new_time") @db.VarChar(5)
  status       String   @default("PENDING")
  decidedBy    String?  @db.Uuid @map("decided_by")
  decidedAt    DateTime? @map("decided_at")
  createdAt    DateTime @default(now()) @map("created_at")
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@map("booking_schedule_changes")
}

model StudioProject {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @unique @db.Uuid @map("booking_id")
  title       String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tasks       ProjectTask[]
  notes       ProjectNote[]
  deliverables ProjectDeliverable[]

  @@map("studio_projects")
}

model ProjectTask {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid @map("project_id")
  title       String
  description String   @default("")
  status      String   @default("TODO")
  sortOrder   Int      @default(0) @map("sort_order")
  dueAt       DateTime? @map("due_at")
  createdAt   DateTime @default(now()) @map("created_at")
  project     StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_tasks")
}

model ProjectNote {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid @map("project_id")
  authorId  String   @db.Uuid @map("author_id")
  content   String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_notes")
}

model ProjectDeliverable {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid @map("project_id")
  name        String
  objectPath  String   @unique @map("object_path")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  visibleAt   DateTime? @map("visible_at")
  createdAt   DateTime @default(now()) @map("created_at")
  project     StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, visibleAt])
  @@map("project_deliverables")
}

model StudioInvoice {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @unique @db.Uuid @map("booking_id")
  invoiceNumber    String   @unique @map("invoice_number")
  serviceName      String   @map("service_name")
  clientName       String   @map("client_name")
  amount           Int
  amountPaid       Int      @map("amount_paid")
  issuedAt         DateTime @default(now()) @map("issued_at")
  status           String   @default("READY_TO_EMAIL")
  recipient        String
  emailedAt        DateTime? @map("emailed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("studio_invoices")
}

model StudioSettings {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("studio_settings")
}

model EmailDelivery {
  id          String   @id @default(uuid()) @db.Uuid
  event       String
  recipient   String
  providerId  String?  @map("provider_id")
  status      String   @default("QUEUED")
  error       String?
  attempts    Int      @default(0)
  retryPayload Json?   @map("retry_payload")
  createdAt   DateTime @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@map("email_deliveries")
}
