{
  "name": "studio-plus-nextjs16",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo-users": "tsx prisma/seed-demo-users.ts",
    "db:studio": "prisma studio",
    "db:legacy-setup": "node --experimental-strip-types scripts/migrate.ts",
    "user:create:legacy": "node --experimental-strip-types scripts/create-user.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "iconsax-react": "^0.0.8",
    "lenis": "^1.3.27",
    "motion": "^14.6.0",
    "next": "^16.4.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.37.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
